# Google Gemini API Configuration
GEMINI_API_KEY=AIzaSyC_your_actual_api_key_here

# Application Settings
APP_NAME=Swan
DEBUG=True
HOST=0.0.0.0
PORT=8000

# AI Model Settings. A model is a spec: "name", "name@<thinking budget>" for 2.5 models
# (e.g. gemini-2.5-flash@0 turns thinking off) or "name@<thinking level>" for 3.x models
# (minimal, low, medium, high). A quote needs no reasoning, and a model left to think can
# spend the whole token budget before writing anything.
DEFAULT_MODEL=gemini-3.5-flash-lite@minimal
MAX_TOKENS=300
TEMPERATURE=0.8
# Only for a 2.5 model given without "@": 0 turns thinking off, "none" leaves it to the model
THINKING_BUDGET=0

# Fallback models, tried in order when the default is rate limited, down or slow (JSON list)
FALLBACK_MODELS=["gemini-2.5-flash-lite@0"]
REQUEST_TIMEOUT=30
LLM_ATTEMPT_TIMEOUT=10
LLM_RETRIES=1
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=30

# Prompt-injection checks on the way in, answer checks (and one regeneration) on the way out
GUARDRAILS_ENABLED=true
MAX_GENERATION_ATTEMPTS=2

# Require "Authorization: Bearer <token>" on /metrics
# METRICS_TOKEN=

# Rate limits per uvicorn worker
RATE_LIMIT_PER_CLIENT=10
RATE_LIMIT_GLOBAL=120

# Extra browser origins allowed to call the API (JSON list); the bundled frontend needs none
# ALLOWED_ORIGINS=["https://example.com"]
